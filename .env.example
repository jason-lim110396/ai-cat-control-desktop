# Environment Variables Template for NekoDesk Desktop Agent
# Copy this file to .env and fill in your private credentials:
# cp .env.example .env

# 1. Google Gemini API (Multimodal Vision Engine)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# 2. LM Studio Local Engine
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
QWEN_MODEL_NAME=qwen2.5-coder-7b-instruct

# 3. Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
ALLOWED_CHAT_ID=123456789

# 4. Web Console & Streaming Server
WEB_HOST=0.0.0.0
WEB_PORT=8000
STREAM_FPS=2
JPEG_QUALITY=65

# 5. OpenRouter / Custom Model API Keys (Optional)
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_KEY_HERE
